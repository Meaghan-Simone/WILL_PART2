@model List<UserSummary>
@{ ViewData["Title"] = "Users"; ViewData["Eyebrow"] = "Admin"; string? q = ViewBag.Q; }
<div class="page-head"><div><h2>Team &amp; access</h2><p>Add, edit and remove people. Admins manage everything and see every lead, sales reps only see and work the leads assigned to them, staff have read-only access.</p></div>
  <div class="page-actions"><a asp-action="Audit" class="btn btn-outline"><i class="bi bi-shield-check"></i> Audit log</a><a asp-action="Create" class="btn btn-green"><i class="bi bi-person-plus"></i> Add user</a></div></div>
<div class="card">
  <form method="get" class="toolbar" style="padding:16px 22px 0"><div class="search"><i class="bi bi-search"></i><input type="text" aria-label="Search" name="q" value="@q" placeholder="Search name, email or job title" maxlength="100"></div><button class="btn btn-outline btn-sm" type="submit">Search</button></form>
  <div class="table-wrap"><table><thead><tr><th scope="col">User</th><th scope="col">Job title</th><th scope="col">Phone</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col" class="text-right">Leads</th><th scope="col">Last sign-in</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>
  @foreach (var u in Model)
  {
    <tr>
      <td><div class="cell-name"><span class="avatar">@UiHelpers.Initials(u.FullName)</span><div><strong>@u.FullName</strong><span>@u.Email</span></div></div></td>
      <td class="text-muted">@(u.JobTitle ?? "—")</td>
      <td class="text-muted">@(u.Phone ?? "—")</td>
      <td><span class="badge @UiHelpers.RoleBadge(u.Role)">@u.Role.Label()</span></td>
      <td>@if (u.IsLocked){<span class="badge badge-amber">Locked</span>}else if (u.IsActive){<span class="badge badge-green">Active</span>}else{<span class="badge badge-gray">Inactive</span>}</td>
      <td class="text-right mono">@u.AssignedLeads</td>
      <td class="text-muted">@(u.LastLoginUtc.HasValue ? UiHelpers.RelativeUtc(u.LastLoginUtc.Value) : "Never")</td>
      <td class="col-actions"><a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline btn-sm"><i class="bi bi-pencil"></i> Edit</a> @if (u.Id != Me.Id)
      {
        if (u.AssignedLeads == 0)
        {
          <form asp-action="Delete" asp-route-id="@u.Id" method="post" style="display:inline" data-confirm="Permanently delete @u.FullName? This cannot be undone."><button type="submit" class="btn btn-ghost btn-sm" title="Delete user" aria-label="Delete user"><i class="bi bi-trash"></i></button></form>
        }
        else
        {
          <a href="@Url.Action("Edit", new { id = u.Id })#danger" class="btn btn-ghost btn-sm" title="Delete user (choose who takes over their leads)" aria-label="Delete user"><i class="bi bi-trash"></i></a>
        }
      }</td>
    </tr>
  }
  @if (Model.Count == 0){<tr><td colspan="8" class="text-muted" style="padding:28px;text-align:center">No users match your search.</td></tr>}
  </tbody></table></div>
</div>
